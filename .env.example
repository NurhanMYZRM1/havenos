# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Hosts that serve the operator console directly (everything else is treated
# as a tenant custom domain and rewritten to /t/<host> by middleware.ts)
NEXT_PUBLIC_APP_HOSTS=localhost:3000,haven-os.vercel.app,app.havenos.co

# ── Desktop app (optional paid cloud backup) ─────────────────────────────────
# Public values baked into the desktop build by `npm run desktop:package`.
# Leave empty for a local-only build (cloud backup shows "not available").
# NEVER put a service-role or secret key here — see docs/cloud-backup.md.
HAVENOS_CLOUD_URL=
HAVENOS_CLOUD_ANON_KEY=
