# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Hosts that serve the operator console directly (everything else is treated
# as a tenant custom domain and rewritten to /t/<host> by middleware.ts)
NEXT_PUBLIC_APP_HOSTS=localhost:3000,haven-os.vercel.app,app.havenos.co
